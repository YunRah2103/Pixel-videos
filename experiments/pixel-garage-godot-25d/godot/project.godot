config_version=5

[application]
config/name="Pixel Garage • True 2.5D Rally Experiment"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/screen_space_aa=0

[physics]
common/physics_ticks_per_second=30