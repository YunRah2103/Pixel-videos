{
  "name": "pixel-videos",
  "version": "0.5.0",
  "private": true,
  "description": "Agent-friendly cinematic pixel art studio (Remotion, PixiJS, Sharp, Pixelorama, Krita, LDtk, Godot)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "preview": "remotion still src/index.ts SunsetHarbor out/sunset-harbor.png --frame=90",
    "render:lowres": "remotion render src/index.ts SunsetHarbor out/sunset-harbor-lowres.mp4",
    "render": "node scripts/render.mjs",
    "demo:offline": "python3 scripts/render_demo.py --seconds 6 --out out/sunset-harbor-offline.mp4",
    "check": "python3 scripts/check_tools.py",
    "tools:check": "python3 scripts/install_studio_v2.py --check",
    "tools:install": "python3 scripts/install_studio_v2.py --all",
    "assets:build": "node scripts/build-pixel-assets.mjs",
    "assets:proof": "node scripts/render-toolkit-proof.mjs",
    "assets:qa": "node scripts/qa-toolkit.mjs",
    "assets:verify": "npm run assets:build && npm run assets:proof && npm run assets:qa",
    "typecheck": "tsc --noEmit",
    "typecheck:toolkit": "tsc --project tsconfig.toolkit.json --noEmit",
    "studio:setup": "node scripts/setup-agent-studio.mjs",
    "studio:check": "npm run tools:check",
    "atlas:build": "node scripts/build-sprite-atlas.mjs",
    "environment:build": "node scripts/build-environment.mjs",
    "environment:proof": "node scripts/render-environment-proof.mjs",
    "visual:qa": "node scripts/qa-visual.mjs",
    "rigs:test": "node scripts/test-studio-rigs.mjs",
    "studio:build": "npm run assets:build && npm run atlas:build && npm run environment:build && npm run rigs:test",
    "studio:verify": "npm run studio:build && npm run environment:proof && npm run visual:qa && npm run typecheck:toolkit",
    "art:check": "python3 scripts/setup_pixel_art_v4.py --check",
    "art:install:snapper": "python3 scripts/setup_pixel_art_v4.py --snapper",
    "art:install:editors": "python3 scripts/setup_pixel_art_v4.py --free-editors",
    "art:install:free": "python3 scripts/setup_pixel_art_v4.py --all-free",
    "art:proof": "node scripts/verify-pixel-art-v4.mjs",
    "art:audit": "node scripts/audit-pixel-art.mjs",
    "art:verify": "npm run assets:build && npm run art:proof && npm run art:audit -- out/artist-v4/sample-snapper-output.png 1",
    "art:v5:check": "python3 scripts/setup_free_pixel_v5.py --check",
    "art:v5:install": "python3 scripts/setup_free_pixel_v5.py --all",
    "art:v5:editors": "python3 scripts/setup_free_pixel_v5.py --editors",
    "art:v5:assets": "python3 scripts/setup_free_pixel_v5.py --art --palette",
    "art:v5:film": "python3 scripts/render_free_pixel_v5.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "remotion": "4.0.538",
    "pixi.js": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
